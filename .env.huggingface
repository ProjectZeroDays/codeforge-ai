# =============================================================================
# CodeForge AI - HuggingFace Spaces Environment Variables
# =============================================================================
# Copy these to HuggingFace Spaces Settings → Variables and Secrets
# =============================================================================

# ----- SECRETS (Set in HF Spaces Secrets) -----
# VENICE_API_KEY=your-venice-api-key
# GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token
# SECRET_KEY=your-secure-random-key

# ----- VARIABLES (Set in HF Spaces Variables) -----
DATABASE_URL=sqlite:///app/data/codeforge.db
USE_SQLITE=true
HOST=0.0.0.0
PORT=7860
DEBUG=false
CORS_ORIGINS=*

# GitHub Configuration (optional)
GITHUB_USERNAME=your-github-username

# Application Settings
APP_NAME=CodeForge AI
APP_VERSION=2.0.0

# AI Provider (venice or local)
DEFAULT_AI_PROVIDER=venice

# Logging
LOG_LEVEL=INFO
