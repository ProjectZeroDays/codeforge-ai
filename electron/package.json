{
  "name": "codeforge-ai",
  "version": "1.0.0",
  "description": "CodeForge AI - AI-Powered Development Platform",
  "main": "main.js",
  "author": "CodeForge AI",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js win32",
    "build:win": "node scripts/build.js win32",
    "build:mac": "node scripts/build.js darwin",
    "build:linux": "node scripts/build.js linux"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.codeforge.ai",
    "productName": "CodeForge AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**",
      "!dist/**",
      "!app/**",
      "!scripts/**",
      "main.js",
      "preload.js",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "app",
        "to": "app",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/assets/icon.png",
      "artifactName": "${productName}-Setup-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/assets/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "electron/assets/icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodeForge AI"
    }
  }
}
